{
  "name": "math-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.mts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.mts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.mts",
    "build:deploy": "tsx scripts/migrate.mts && tsx scripts/seed.mts && next build"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "15.5.29",
    "pdfjs-dist": "^4.10.38",
    "postgres": "^4.1.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
