# Postgres connection string (Supabase: use the "Transaction pooler" URI, port 6543)
DATABASE_URL=postgres://user:pass@host:6543/postgres
# Long random string used to sign short-lived file links
APP_SECRET=
# Time zone used to decide "today" for subscriptions
APP_TIMEZONE=Africa/Cairo
# local (files in ./uploads) or supabase
STORAGE_DRIVER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=lesson-files
# Used only by the seed script to create the teacher account
TEACHER_USERNAME=teacher
TEACHER_PASSWORD=
